generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PingLog {
  id        String   @id @default(uuid())
  source    String
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ping_log")
}

enum FacultadSso {
  FICCT
}

enum CarreraSso {
  INGENIERIA_SISTEMAS
  INGENIERIA_INFORMATICA
  INGENIERIA_REDES_TELECOMUNICACIONES
  INGENIERIA_ROBOTICA
}

enum TipoUsuarioSso {
  ESTUDIANTE
  DOCENTE
  ADMINISTRATIVO
}

enum EstadoAcademicoSso {
  ACTIVO
  INACTIVO
}

enum PlatformRole {
  ADMIN
  AUTORIDAD_REGISTRO
  AUDITOR
}

model PlatformUser {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String       @map("password_hash")
  nombreCompleto String       @map("nombre_completo")
  role           PlatformRole
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("platform_users")
}

model MockSsoUser {
  id                  String             @id @default(uuid())
  codigoInstitucional String             @unique @map("codigo_institucional")
  passwordHash        String             @map("password_hash")
  nombreCompleto      String             @map("nombre_completo")
  facultad            FacultadSso
  carrera             CarreraSso
  tipoUsuario         TipoUsuarioSso     @map("tipo_usuario")
  estadoAcademico     EstadoAcademicoSso @map("estado_academico")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@map("mock_sso_users")
}
