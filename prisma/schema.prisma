generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PingLog {
  id        String   @id @default(uuid())
  source    String
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ping_log")
}

enum FacultadSso {
  FICCT
}

enum CarreraSso {
  INGENIERIA_SISTEMAS
  INGENIERIA_INFORMATICA
  INGENIERIA_REDES_TELECOMUNICACIONES
  INGENIERIA_ROBOTICA
}

enum TipoUsuarioSso {
  ESTUDIANTE
  DOCENTE
  ADMINISTRATIVO
}

enum EstadoAcademicoSso {
  ACTIVO
  INACTIVO
}

enum PlatformRole {
  ADMIN
  AUTORIDAD_REGISTRO
  AUDITOR
  SUPERUSUARIO
}

model PlatformUser {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String       @map("password_hash")
  nombreCompleto String       @map("nombre_completo")
  role           PlatformRole
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  authorities    Authority[]

  @@map("platform_users")
}

enum ElectionStatus {
  BORRADOR
  REGISTRO_ABIERTO
  VOTACION_ABIERTA
  CERRADA
}

model Election {
  id                            String              @id @default(uuid())
  nombre                        String
  descripcion                   String?
  registroInicio                DateTime            @map("registro_inicio")
  registroFin                   DateTime            @map("registro_fin")
  votacionInicio                DateTime            @map("votacion_inicio")
  votacionFin                   DateTime            @map("votacion_fin")
  estado                        ElectionStatus      @default(BORRADOR)
  profundidadArbol              Int?                @map("profundidad_arbol")
  elegibilidadFacultad          FacultadSso?        @map("elegibilidad_facultad")
  elegibilidadCarreras          CarreraSso[]        @default([]) @map("elegibilidad_carreras")
  elegibilidadTipoUsuario       TipoUsuarioSso?     @map("elegibilidad_tipo_usuario")
  elegibilidadEstadoAcademico   EstadoAcademicoSso? @map("elegibilidad_estado_academico")
  padronConfiguradoEn           DateTime?           @map("padron_configurado_en")
  checkpointIntervalMinutes     Int?                @map("checkpoint_interval_minutes")
  rateLimitThresholdPerMinute   Int?                @map("rate_limit_threshold_per_minute")
  checkpointPolicyConfiguradoEn DateTime?           @map("checkpoint_policy_configurado_en")
  createdAt                     DateTime            @default(now()) @map("created_at")
  createdBy                     String              @map("created_by")
  updatedAt                     DateTime            @updatedAt @map("updated_at")
  updatedBy                     String              @map("updated_by")
  opciones                      Option[]
  authorities                   Authority[]
  registrationRequests          RegistrationRequest[]
  presentedCredentials          PresentedCredential[]

  @@map("elections")
}

model Option {
  id          String   @id @default(uuid())
  electionId  String   @map("election_id")
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([electionId])
  @@map("options")
}

model Authority {
  id             String       @id @default(uuid())
  electionId     String       @map("election_id")
  election       Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  platformUserId String       @map("platform_user_id")
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id])
  rolDescriptivo String       @map("rol_descriptivo")
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      String       @map("created_by")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  updatedBy      String       @map("updated_by")

  @@unique([electionId, platformUserId])
  @@index([electionId])
  @@map("authorities")
}

enum RegistrationRequestStatus {
  PENDING
  QUEUED
  BATCHED
  INSERTED
  REJECTED
}

// CU-05: una fila por votante que se registra a una eleccion. No contiene
// identidad real - scopedTokenHash es HMAC(SSO_MOCK_SECRET, sub + electionId),
// no reversible hacia el UUID real desde este servicio (regla 2 del CLAUDE.md
// raiz). batchId/aprobaciones de CU-07 en adelante quedan fuera por ahora,
// ver docs/modelo-bd-registro.md.
model RegistrationRequest {
  id              String                    @id @default(uuid())
  electionId      String                    @map("election_id")
  election        Election                  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  scopedTokenHash String                    @map("scoped_token_hash")
  blindedValue    String                    @map("blinded_value")
  status          RegistrationRequestStatus @default(PENDING)
  createdAt       DateTime                  @default(now()) @map("created_at")

  @@unique([electionId, scopedTokenHash])
  @@index([electionId])
  @@map("registration_requests")
}

enum PresentedCredentialStatus {
  PENDING
  BATCHED
  INSERTED
  REJECTED
}

// Segundo paso, anonimo, de CU-05: el dispositivo presenta la credencial
// certificada (commitment real + firma ya descegada) sin ninguna conexion
// con el registro original (sin scoped_token_hash, sin assertion). La firma
// RSA valida es la unica prueba de habilitacion que exige este endpoint.
// Ver src/modules/registration/README.md.
model PresentedCredential {
  id              String                    @id @default(uuid())
  electionId      String                    @map("election_id")
  election        Election                  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  commitment      String
  preparedMessage String                    @map("prepared_message")
  signature       String
  status          PresentedCredentialStatus @default(PENDING)
  presentedAt     DateTime                  @default(now()) @map("presented_at")

  @@unique([electionId, commitment])
  @@index([electionId])
  @@map("presented_credentials")
}

model MockSsoUser {
  id                  String             @id @default(uuid())
  codigoInstitucional String             @unique @map("codigo_institucional")
  passwordHash        String             @map("password_hash")
  nombreCompleto      String             @map("nombre_completo")
  facultad            FacultadSso
  carrera             CarreraSso
  tipoUsuario         TipoUsuarioSso     @map("tipo_usuario")
  estadoAcademico     EstadoAcademicoSso @map("estado_academico")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@map("mock_sso_users")
}
