generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PingLog {
  id        String   @id @default(uuid())
  source    String
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ping_log")
}
